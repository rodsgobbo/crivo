# Segredos do operador. Copie para .env e preencha; nunca versione o .env.
# Nenhum destes valores pode aparecer em config/*.toml.

CRIVO_MASTER_KEY=
CRIVO_DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Opcional, só para desenvolvimento. Com 1, true, sim, yes ou on, a rota de
# entrada local passa a existir e dispensa o fluxo do Google; vazio, ela nem é
# registrada. Nunca ligue numa instalação que outra pessoa alcança.
CRIVO_DEV_LOGIN=
