*.egg-info/
.venv/

# Dado pessoal. O banco guarda curriculo, extracao e perfil-alvo; a pasta de
# entrada guarda os arquivos originais. Nada aqui pode ir para um repositorio.
data/

# Saida gerada pelo demo. O banco dela nasce de um perfil de exemplo semeado a
# partir de dados reais -- nome de pessoa entre eles --, e e reconstruida por
# `python demo/run_demo.py`. Publicar o artefato exporia o dado sem entregar
# nada que o script nao refaca.
demo/saida/

# Arvore intermediaria do setuptools, criada por `python -m build`. E copia do
# que ja esta em src/ -- versionar as duas faz o repositorio carregar cada
# modulo em duplicata e divergir na primeira edicao que esquecer uma delas.
build/
dist/
